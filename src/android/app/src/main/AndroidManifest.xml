        android:label="@string/app_name"
        android:roundIcon="@mipmap/mainicon_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Project01"
        tools:targetApi="31">
        <activity
            android:name=".ParentsMapActivity"
            android:exported="false" />
        <activity
            android:name=".ParentsMapActivity"
